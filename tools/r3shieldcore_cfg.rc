/* ============================================================================
 *  r3shieldcore_cfg.rc —— 「配置与日志」工具的资源脚本（图标 + 版本信息）
 *
 *  ★ 图标：复用引擎那份 r3shieldcore.ico（由 installer/make_icon.py 按需生成，
 *    .ico 不入库）。build_cfgtool.sh 用 rc.exe 的 -I 指向 R3ShieldCore/rsrc，
 *    所以这里写文件名即可。
 *
 *  ★ 版本信息为什么写在这里（而引擎是交给 link 的 /VERSION）：
 *    link 的 /VERSION 只能给两段（"1.0"），拿不到 FileDescription 这类字符串；
 *    本工具**不传** /VERSION，改由本文件提供完整 VS_VERSION_INFO。
 *    ⚠️ 两者只能取其一 —— 同时存在会在资源表里出现两个 VERSION 条目。
 *
 *  ★ 中文：文件存 UTF-8，靠 #pragma code_page(65001) 让 rc.exe 按 UTF-8 解码。
 * ==========================================================================*/

#pragma code_page(65001)

#include <winresrc.h>

1 ICON "r3shieldcore.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "R3 ShieldCore"
            VALUE "FileDescription",  "R3 ShieldCore 配置与日志"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "r3shieldcore-cfg"
            VALUE "OriginalFilename", "r3shieldcore-cfg.exe"
            VALUE "ProductName",      "R3 ShieldCore"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
