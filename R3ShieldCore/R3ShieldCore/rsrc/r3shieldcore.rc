/* ============================================================================
 *  r3shieldcore.rc —— R3 ShieldCore 引擎 exe 的资源脚本（图标 / 版本信息）
 *
 *  为什么需要这个文件
 *  ==================
 *  在此之前引擎 exe **没有任何资源区**，于是三处图标全是系统的空白默认图标：
 *    · 资源管理器 / 桌面上看到的 exe 图标；
 *    · 窗口标题栏左上角 + 任务栏按钮（GUI 里写死了 LoadIcon(IDI_APPLICATION)）；
 *    · Alt+Tab 切换器。
 *  安装程序早就有了自己的 101 ICON（installer/r3sc_setup.rc），
 *  但引擎本身没有 —— 装完以后"主程序"反而是那个最不像正经软件的一个。
 *
 *  ★ 图标资源 ID 用 1（不是 101）
 *  =============================
 *  两个 exe 的资源是**各自独立**的，ID 撞不撞无所谓。这里用 1 是因为
 *  它是 Windows 的**约定俗成**值：壳层在"exe 没有图标资源"时退回的
 *  默认图标就是按 ID 1 找的。写 1 最不容易出意外。
 *  ★★ 但代码里**必须**用 LoadIcon(hInstance, MAKEINTRESOURCE(IDI_APP_ICON))
 *      —— 不能写 LoadIcon(nullptr, ...)：传 nullptr 时 Windows 只去
 *      **系统模块**里找，永远看不到我们自己编进去的这个图标。
 *      GUI 里原来那两行 LoadIcon(nullptr, IDI_APPLICATION) 就是这个毛病。
 *
 *  ★ 编译方式
 *  ==========
 *  这个文件由 build.sh 用 SDK 的 **rc.exe** 编译（不是 windres）：
 *      rc.exe /nologo /fo <tmp>\r3shieldcore.res /I <rsrc目录> r3shieldcore.rc
 *  原因：
 *    · rc.exe 是 MSVC 工具链的原生资源编译器，与 cl/link 同源，最稳；
 *    · rc.exe 是 Unicode 程序，即使项目根目录带中文也没问题，
 *      处理中文路径没有问题 —— 不像 windres（ANSI，必须先进纯 ASCII 暂存目录）。
 *  ★ 但 rc.exe 的**预处理**对 `#include` 的路径解析依赖 /I 与 cwd，
 *    所以 build.sh 里是先 cd 到 R3ShieldCore/ 再把相对路径喂给 rc.exe 的
 *    （与 cl.exe 相同的约定，见 build.sh 开头的注释）。
 *
 *  ★ 版本信息（v1.0.1 修正）
 *  ==========================
 *  ★★★ 这里原来写着"link.exe 会**自动**根据 /VERSION 生成一份 VS_VERSION_INFO，
 *    所以本文件只管图标" —— **那是错的**，而且是"看着配了其实没有"的典型：
 *      · link 的 `/VERSION:x.y` 只写进 PE 可选头的 **ImageVersion** 两个字段，
 *        它**不是**资源，也不会生成 RT_VERSION；
 *      · 实测（v1.0.1 出包前）：主程序的资源类型只有 [3(ICON), 14(GROUP_ICON),
 *        24(MANIFEST)]，**没有 16(RT_VERSION)** ⇒ 资源管理器「详细信息」里
 *        文件版本/产品版本全是空，右键属性看不到任何版本号。
 *    ⇒ 现在版本信息**写在本文件里**（与 installer/r3sc_setup.rc、tools/
 *      r3shieldcore_cfg.rc 一样），/VERSION 只当镜像版本号用，两者不再互相依赖。
 *    ⚠️ 原来那句"两边都写会出现两个 VERSION 条目"的担心不成立 ——
 *      /VERSION 根本不产生资源条目，所以不存在重复。
 *    ⚠️ 版本号必须与仓库根的 `VERSION` 文件一致（闸门 check_dist_sync.sh 会比对）。
 * ==========================================================================*/

/* 源码是 UTF-8 无 BOM，而 rc.exe 默认按系统代码页(936)解 —— 下面有中文
 * 字符串，必须显式声明代码页（与 tools/r3shieldcore_cfg.rc 同一写法）。 */
#pragma code_page(65001)

#include <winresrc.h>

/* 引擎 exe 的图标。ID 用 1（约定值），代码里按 MAKEINTRESOURCE(1) 取。 */
1 ICON "r3shieldcore.ico"

/* 版本信息。
 * 语言块 080404b0 = 简体中文(0x0804) + Unicode(0x04b0)。
 * Translation 的值必须和语言块对应，否则资源管理器里「详细信息」是空的。 */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "R3 ShieldCore"
            VALUE "FileDescription",  "R3 ShieldCore 主程序"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "R3 ShieldCore"
            VALUE "LegalCopyright",   "R3 ShieldCore"
            VALUE "OriginalFilename", "R3 ShieldCore.exe"
            VALUE "ProductName",      "R3 ShieldCore"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
